// clang-format off
#ifndef TMPLGEN
typedef int T;
#endif

// @trait Ord(T)
int compare(T lhs, T rhs);
// @end

// @impl Ord(int)
static inline long compare(int lhs, int rhs) { return (lhs > rhs) - (lhs < rhs); }
// @end

// @template T: Ord
static inline T max_ord(T lhs, T rhs)
{
    return Ord_compare(lhs, rhs) >= 0 ? lhs : rhs;
}
