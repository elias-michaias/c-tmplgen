// clang-format off
#ifndef TMPLGEN
typedef int T;
#endif

// @trait Eq(T)
int equal(T lhs, T rhs);
// @end

// @trait Ord(T)
int compare(T lhs, T rhs);
// @end

// @impl Eq(int)
static inline int equal(int lhs, int rhs) { return lhs == rhs; }
// @end

// @impl Ord(int)
static inline int compare(int lhs, int rhs) { return (lhs > rhs) - (lhs < rhs); }
// @end

// @template T: Ord
static inline int ordered_equal(T lhs, T rhs)
{
    return Eq_equal(lhs + 0, rhs + 0);
}
