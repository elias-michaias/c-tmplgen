// clang-format off
#ifndef TMPLGEN
typedef int T;
#endif

// @trait Eq(T)
int equal(T lhs, T rhs);
// @end

// @trait Ord(T)
int compare(T lhs, T rhs);
// @end

// @impl Eq(int)
static inline int equal(int lhs, int rhs) { return lhs == rhs; }
// @end

// @impl Ord(int)
static inline int compare(int lhs, int rhs) { return (lhs > rhs) - (lhs < rhs); }
// @end

// @template T: Eq
static inline int need_equal(T lhs, T rhs) { return Eq_equal(lhs, rhs); }

// @template T: Ord
static inline int ordered_call(T lhs, T rhs) { return need_equal(lhs, rhs); }
