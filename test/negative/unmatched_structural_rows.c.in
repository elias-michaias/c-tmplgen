#include "test/lib/physics.h"

struct WrongPhysics {
    int x;
    double y;
};

struct WrongActor {
    int id;
    int name;
    unsigned flags;
};

#include "gen/all.gen.h"

int main(void)
{
    struct WrongPhysics physics = { 1, 2.0 };
    struct WrongActor actor = { 3, 4, 5U };
    char tiny = 0;
    int narrow = 1;
    long long wide = 7LL;
    return physics_sum(&physics) + named_actor_id(&actor) +
           alignment_ok(&tiny) + same_size(narrow, wide);
}
