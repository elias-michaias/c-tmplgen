CompileFlags:
  Add: [-std=c99]
---
If:
  PathMatch: test/tmpl/.*[.]tmpl[.]h
CompileFlags:
  Add: [-x, c]
---
If:
  PathMatch: test/gen/.*[.]gen[.]h
CompileFlags:
  Add: [-x, c]
---
If:
  PathMatch: plugin/.*[.]cpp
CompileFlags:
  Remove: [-std=*]
  Add: [-std=c++17]
---
If:
  PathMatch: test/cases/(generic_dispatch|string_dispatch|result_dispatch|triple_dispatch|builtin_types|module_include|tagged_struct|function_recursion)[.]c
CompileFlags:
  Remove: [-std=*]
  Add: [-std=c11]
---
If:
  PathMatch: test/cases/auto_c23[.]c
CompileFlags:
  Remove: [-std=*]
  Add: [-std=c23]
---
If:
  PathMatch: test/cases/auto_type_c11[.]c
CompileFlags:
  Remove: [-std=*]
  Add: [-std=c11]
---
If:
  PathMatch: test/cases/gnu_dispatch[.]c
CompileFlags:
  Remove: [-std=*]
  Add: [-std=gnu99]
---
If:
  PathMatch: test/cases/reflect_[a-z]+[.]c
CompileFlags:
  Remove: [-std=*]
  Add: [-std=c11]
---
If:
  PathMatch: (test/(cases|lib|negative)/.*|test/gen/reflection)[.]h
CompileFlags:
  Remove: [-std=*]
  Add: [-x, c, -std=c11]
